{
  "version": 1,
  "application": {
    "name": "oficina-cadastro",
    "environment": "Production",
    "containerPort": 8080
  },
  "aws": {
    "namespaceParameter": "/oficina/infra/k8s/namespace",
    "instanceIdParameter": "/oficina/infra/k8s/instance-id",
    "ecrRepositoryParameter": "/oficina/infra/ecr/cadastro",
    "regionFromWorkflow": true
  },
  "kubernetes": {
    "deploymentName": "oficina-cadastro",
    "serviceName": "oficina-cadastro",
    "containerName": "oficina-cadastro",
    "migrationJobPrefix": "oficina-cadastro-migration",
    "replicas": 1,
    "nodePort": 30080,
    "targetGroupArnParameter": "/oficina/infra/services/cadastro/target-group-arn",
    "nodePortParameter": "/oficina/infra/services/cadastro/node-port",
    "manifests": {
      "configMap": "k8s/configmap.yaml",
      "deployment": "k8s/deployment.yaml",
      "service": "k8s/service.yaml",
      "migrationJob": "k8s/migration-job.yaml",
      "secretApp": "k8s/secret-app-template.yaml",
      "secretMigration": "k8s/secret-migration-template.yaml"
    }
  },
  "secrets": {
    "runtimeDatabase": "/oficina/cadastro/runtime-db",
    "migrationDatabase": "/oficina/cadastro/migration-db"
  },
  "health": {
    "path": "/health",
    "readinessPath": "/ready",
    "initialDelaySeconds": 10,
    "periodSeconds": 10,
    "timeoutSeconds": 3,
    "failureThreshold": 6
  },
  "deployment": {
    "progressDeadlineSeconds": 600,
    "terminationGracePeriodSeconds": 30
  },
  "deploy": {
    "s3Prefix": "k8s-deploy/cadastro/",
    "parameterPathPrefix": "/oficina/deploy/cadastro/",
    "presignedUrlTtlSeconds": 300,
    "maxManifestBytes": 30000,
    "rolloutTimeoutSeconds": 600,
    "migrationTimeoutSeconds": 900
  },
  "coverage": {
    "minimumLinePercentage": 80
  }
}
